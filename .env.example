# All settings are optional; defaults give a fully offline mock stack.
# Backends: mock | faster_whisper (STT), mock | ollama (LLM), mock | system | piper (TTS)
VA_STT_BACKEND=mock
VA_LLM_BACKEND=mock
VA_TTS_BACKEND=mock

# Ollama (only used when VA_LLM_BACKEND=ollama). Pull the model first: `ollama pull llama3.2`
VA_OLLAMA_HOST=http://127.0.0.1:11434
VA_OLLAMA_MODEL=llama3.2
VA_WHISPER_MODEL=base.en

# Storage (":memory:" for ephemeral)
VA_DB_PATH=data/voice_agent.db

# Reliability
VA_STT_TIMEOUT_S=8
VA_LLM_TIMEOUT_S=15
VA_MAX_SESSIONS=64
VA_RECONNECT_GRACE_S=60

# Human-in-the-loop: tools that need operator approval, and how long the caller waits
VA_APPROVAL_TOOLS=cancel_appointment,escalate_to_human
VA_APPROVAL_WAIT_S=30
# Protect operator endpoints/dashboard (leave empty only on localhost)
VA_OPERATOR_TOKEN=
